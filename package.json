{
  "name": "inga",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI agent arena prototype with Next.js 15, React 19, and TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "NEXT_DISABLE_DEVTOOLS=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "agent:once": "tsx src/agent/cli.ts",
    "agent:loop": "tsx src/agent/cli.ts --loop",
    "agent:demo3m": "tsx src/agent/demo.ts --seconds 180",
    "build:runner": "esbuild src/agent/cli.ts --bundle --platform=node --format=cjs --outfile=dist-runner.cjs",
    "polymarket:keys": "tsx scripts/polymarket-keys.ts",
    "analyze:evaluations": "tsx scripts/analyze-evaluations.ts",
    "polymarket:approve-usdc": "tsx scripts/enable-usdc.ts",
    "db:info": "tsx scripts/db-info.ts",
    "positions:close": "tsx scripts/close-positions.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "probe:web": "tsx scripts/probe-web-search.ts",
    "polymarket:account": "tsx scripts/polymarket-account.ts",
    "positions:sync-live": "tsx scripts/sync-live-positions.ts"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@polymarket/clob-client": "^4.22.8",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.4.1",
    "ethers": "^5.7.2",
    "next": "^15.5.9",
    "pg": "^8.12.0",
    "react": "^19.0.3",
    "react-dom": "^19.0.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "20.12.7",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "^10.4.21",
    "dotenv": "16.4.5",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.9",
    "jsdom": "24.1.0",
    "msw": "2.4.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "vitest": "1.6.0"
  }
}
