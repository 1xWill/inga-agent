# OpenRouter / LLM providers
OPENROUTER_API_KEY=sk-openrouter-placeholder

# Polymarket — L1 wallet and L2 API auth (copy, then populate)
# 1) Choose wallet path:
#    - Browser wallet (MetaMask/Coinbase): export private key (0x...)
#    - Polymarket Email (Magic): export at https://reveal.magic.link/polymarket
# 2) Paste the private key below; the keys script will derive L2 API creds.

# Chain and hosts (defaults shown; keep for production unless instructed)
# POLY_CHAIN_ID=137
# POLY_CLOB_HOST=https://clob.polymarket.com

# L1 wallet (required to derive API keys)
# - Private key: hex for the EOA you’ll trade with, without 0x-prefixed
# - Signature type: 0 = browser wallets; 1 = Magic/Email login
# - Default to 0
# POLY_SIGNATURE_TYPE=0

# - Use `POLY_L1_PRIVATE_KEY=xxx npm run polymarket:keys` to get clob keys, but actually used agent specific keys as below
POLY_WALLET_KEY_GPT=
POLY_WALLET_KEY_DS=

# Addresses (populate after you pick your wallet)
# - POLY_ADDRESS: the EOA address of POLY_L1_PRIVATE_KEY (auto from script)
# - POLY_FUNDER_ADDRESS: address that holds USDC on Polygon (often same as POLY_ADDRESS)
# - Defaults to your wallet address
# POLY_ADDRESS=
# POLY_FUNDER_ADDRESS=

# L2 API credentials (derive via: `npm run polymarket:keys`)
# - Returned by Polymarket CLOB after L1 EIP-712 auth; required for private endpoints, returned env vars as below
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=

# But actually renamed to below for per agent usages

POLY_API_KEY_GPT=
POLY_API_SECRET_GPT=
POLY_API_PASSPHRASE_GPT=

POLY_API_KEY_GROK=
POLY_API_SECRET_GROK=
POLY_API_PASSPHRASE_GROK=

POLY_API_KEY_CLAUDE=
POLY_API_SECRET_CLAUDE=
POLY_API_PASSPHRASE_CLAUDE=

POLY_API_KEY_DS=
POLY_API_SECRET_DS=
POLY_API_PASSPHRASE_DS=

POLY_API_KEY_QWEN=
POLY_API_SECRET_QWEN=
POLY_API_PASSPHRASE_QWEN=

# Database / Deployment
# Local/tests default to SQLite; Railway (live) uses Postgres.
# DB_DRIVER=sqlite|postgres
DB_DRIVER=sqlite
PAPER_DB_FILE=data/inga.sqlite
# DATABASE_URL for Postgres (Railway injects automatically when attached to the Postgres plugin)
# Example: postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=

# Postgres pool tuning (keep tiny)
# Set on web and worker in Railway
PGPOOL_MAX=3
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# Identify service in pg_stat_activity (set differently per service)
# PG_APP_NAME=inga-web

# Production hardening for operator endpoints
# When true, /api/agent/* endpoints return 404 (use CLI/worker only)
DISABLE_OPERATOR_API=false

# Worker-only auto-cancel
# - Enables TTL-based order cancelation in the worker's orders refresher
# - Do NOT set this in the web service; set it only on the worker
# WORKER_ENABLE_AUTOCANCEL=true
